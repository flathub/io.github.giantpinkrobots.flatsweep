{
    "id": "io.github.giantpinkrobots.flatsweep",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "command": "flatsweep",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
        "--filesystem=home/.var/app/",
        "--filesystem=/var/lib/flatpak/app:ro",
        "--filesystem=home/.local/share/flatpak/app:ro"
    ],
    "modules": [
        {
            "name": "flatsweep",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/giantpinkrobots/flatsweep.git",
                    "commit": "5447eae1ef62388c3a7bfa2b1a475e5df7cbf7c9"
                }
            ]
        }
    ]
}
